mapscripts RustboroCity_Flat1_2F_MapScripts {}

script RustboroCity_Flat1_2F_EventScript_WaldasDad {
	lock
	faceplayer
	msgbox("My daughter Walda has been so hard to
			make happy… 
			
			I tried buying all kinds of dolls but
			she never even cracked a smile…
			
            However, when I recently took her to
			the Banana Slakoth Garden, she was
			smiling ear to ear!
    
            I managed to convince the employees
            to let me adopt one of them.")
	release
	end
}

script RustboroCity_Flat1_2F_EventScript_WaldasMom {
	lock
	faceplayer
	msgbox("Oh, it's so hard every day…
            
			What's hard?
            You need to ask?

			It's trying to figure out what to
			make for meals every day.

			It really isn't easy coming up with
            meals every day.")
	release
	end
}

script RustboroCity_Flat1_2F_EventScript_Walda {
	lock
	faceplayer
	msgbox("Look at him! Slakoth is so cute!")
	release
	end
}

script RustboroCity_Flat1_2F_EventScript_Slakoth {
	lock
	faceplayer
	waitse
	playmoncry(SPECIES_SLAKOTH, 0)
	msgbox("Slakoth: Zzzzzz?")
	waitmoncry
	release
	end
}

script RustboroCity_Flat1_2F_EventScript_PokeDoll {
	msgbox("It's a Pokémon plush Doll!", MSGBOX_SIGN)
	end
}
