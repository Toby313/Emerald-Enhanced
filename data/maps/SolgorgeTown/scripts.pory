mapscripts SolgorgeTown_MapScripts {
    ON_TRANSITION {
        setflag(FLAG_VISITED_SOLGORGE_TOWN)
        call(RyuCheckForWellTravelledAch)
        end
    }
}

script SolgorgeTown_EventScript_TownSign {
	msgbox("Solgorge Town
            “A frontier outpost bathed in sunlight”", MSGBOX_SIGN)
	end
}
